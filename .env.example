# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Server Configuration
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:3000
ADMIN_PRIVATE_SLUG=pf-ops-9482

# Security Secrets (Use strong 64-char hex/random values in production)
JWT_SECRET=replace_with_strong_random_jwt_secret
JWT_EXPIRES_IN=7d
BOT_GATE_JWT_SECRET=replace_with_strong_random_bot_gate_secret
TOKEN_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Neon PostgreSQL
DATABASE_URL=postgresql://user:password@ep-example.us-east-2.aws.neon.tech/pipflow?sslmode=require

# Official Deriv API (Register at developers.deriv.com)
DERIV_APP_ID=1089
DERIV_CLIENT_SECRET=
DERIV_OAUTH_SCOPES=trade account_manage
DERIV_WS_URL=wss://ws.derivws.com/websockets/v3
DERIV_OAUTH_URL=https://auth.deriv.com/oauth2/auth
DERIV_OAUTH_REDIRECT_URI=http://localhost:3000/api/deriv/oauth/callback

# Brevo Transactional Email
BREVO_API_KEY=xkeysib-replace_with_real_brevo_api_key
BREVO_SENDER_EMAIL=noreply@pipflow.site
BREVO_SENDER_NAME=PIPFLOW

# Frontend Build Variables (apps/web)
VITE_API_URL=
VITE_WS_URL=
VITE_DERIV_APP_ID=1089
VITE_ADMIN_PRIVATE_SLUG=pf-ops-9482
